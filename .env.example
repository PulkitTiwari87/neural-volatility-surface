# .env.example — PLACEHOLDERS ONLY. Copy to `.env` (git-ignored) and fill locally.
# Status: PLANNED. No code reads these variables yet; names may change when the
# configuration module is designed (see docs/operations/CONFIGURATION.md).
# Never put real credentials in this file. Never commit `.env`.

# --- General ---
# development | test | production   (production semantics are not defined yet; DEC-013)
VOLLAB_ENV=development

# --- Paths (relative to repo root; contents are git-ignored) ---
VOLLAB_DATA_DIR=./data
VOLLAB_ARTIFACTS_DIR=./artifacts
VOLLAB_EXPERIMENTS_DIR=./experiments

# --- Data provider (provider NOT selected; DEC-002) ---
# Server-side only. Must never be exposed to frontend code or logs.
VOLLAB_PROVIDER_NAME=
VOLLAB_PROVIDER_API_KEY=
VOLLAB_PROVIDER_BASE_URL=

# --- API (framework NOT selected; DEC-007) ---
VOLLAB_API_HOST=127.0.0.1
VOLLAB_API_PORT=
# Required before exposing the API beyond localhost (see docs/engineering/SECURITY.md)
VOLLAB_API_AUTH_SECRET=

# --- Logging ---
VOLLAB_LOG_LEVEL=INFO
