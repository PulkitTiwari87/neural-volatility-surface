<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="description" content="Read-only Volatility Surface Viewer and research workbench for stored implied-volatility runs. Research and education only; not a trading tool.">
<meta name="referrer" content="no-referrer">
<title>Neural Volatility Surface · Quantitative Research Workbench</title>
<style>
/* Tokens: dashboard-design/DESIGN_SYSTEM.md. Fonts: the research server's CSP blocks font files, so Geist and
   JetBrains Mono are used only if installed locally; otherwise the system stack applies. */
:root{
  --font:"Geist",system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",sans-serif;
  --mono:"JetBrains Mono",ui-monospace,"Cascadia Mono",Consolas,monospace;
  --r-sm:6px;--r:8px;--r-lg:12px;
}
[data-theme=dark]{
  --bg:#0c1016;--s1:#121821;--s2:#18202b;--s3:#202a37;--line:#2a3544;
  --ink:#e6ebf2;--ink2:#a7b2c2;--muted:#7d8999;--accent:#86c8e8;--on-accent:#0c1016;--focus:#86c8e8;
  --ok:#5fb589;--prog:#e0a53a;--plan:#8a9bb5;--block:#e5675e;--na:#8c97a8;--unv:#c9b26b;--fail:#e5675e;
  --warn-bg:#2b2412;--err-bg:#2c1a1b;
  --lo:27,58,85;--hi:143,208,240;
}
[data-theme=light]{
  --bg:#f3f5f7;--s1:#ffffff;--s2:#e8ecf0;--s3:#dde3ea;--line:#cfd6de;
  --ink:#111722;--ink2:#4b586a;--muted:#5a6575;--accent:#1f6f99;--on-accent:#ffffff;--focus:#1f6f99;
  --ok:#276b49;--prog:#8a5a0e;--plan:#4f5f7a;--block:#a93a33;--na:#5a6575;--unv:#75621c;--fail:#a93a33;
  --warn-bg:#f4ead2;--err-bg:#f6e0de;
  --lo:27,58,85;--hi:31,111,153;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 15px/1.55 var(--font);-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{margin:0;font-weight:600;letter-spacing:-.02em;line-height:1.2}
p{margin:0}
a{color:var(--accent);text-underline-offset:3px}
button,select,input{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px;border-radius:4px}
.skip{position:absolute;left:8px;top:-60px;background:var(--accent);color:var(--on-accent);padding:10px 14px;border-radius:var(--r);z-index:100;font-weight:600}
.skip:focus{top:8px}
.mono{font-family:var(--mono);font-size:.9em}
.muted{color:var(--muted)}.ink2{color:var(--ink2)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
svg.ico{width:1em;height:1em;flex:none;display:block}

/* ---------- shared components ---------- */
.btn{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;flex:none;min-height:44px;padding:0 18px;border-radius:var(--r);border:1px solid transparent;cursor:pointer;font-weight:600;text-decoration:none;transition:transform .12s ease-out,background-color .15s}
.btn:active{transform:translateY(1px)}
.btn.primary{background:var(--accent);color:var(--on-accent)}
.btn.dark{background:#111722;color:#fff}
.btn.bsec{background:var(--s2);color:var(--ink)}
.btn.sm{min-height:40px;padding:0 12px;font-weight:500}
.btn[disabled]{opacity:.5;cursor:not-allowed}
.link{color:var(--accent);font-weight:500;text-decoration:underline;text-underline-offset:4px;display:inline-flex;gap:6px;align-items:center}
.chip{display:inline-flex;align-items:center;gap:6px;padding:3px 10px 3px 8px;border-radius:var(--r-sm);background:var(--s2);font-size:13px;font-weight:500;white-space:nowrap;line-height:1.5}
.chip svg{width:15px;height:15px}
.chip.completed{color:var(--ok)}.chip.progress{color:var(--prog)}.chip.planned{color:var(--plan)}
.chip.blocked{color:var(--block)}.chip.unavailable{color:var(--na)}.chip.unverified{color:var(--unv)}.chip.failed{color:var(--fail)}
.chip.neutral{color:var(--ink2)}
.src{font-size:13px;color:var(--muted);display:inline-flex;gap:6px;align-items:center;white-space:nowrap}
.src.live{color:var(--accent)}
.src i{width:7px;height:7px;border-radius:50%;background:currentColor;display:inline-block}
.panel{background:var(--s1);border-radius:var(--r-lg);padding:22px 24px;min-width:0}
.panel>header{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:16px;flex-wrap:wrap}
.panel h2,.panel h3{font-size:20px}
.panel .foot{margin-top:14px;font-size:13px;color:var(--muted)}
.stack{display:flex;flex-direction:column;gap:24px}
.row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.kv{display:grid;grid-template-columns:minmax(120px,40%) 1fr;gap:10px 16px;margin:0}
.kv dt{color:var(--ink2)}.kv dd{margin:0;text-align:right;overflow-wrap:anywhere}
.tablewrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
table.t{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}
table.t th{font-weight:500;color:var(--ink2);font-size:13px;text-align:left;padding:10px 12px;background:var(--s2);white-space:nowrap}
table.t th:first-child{border-radius:var(--r) 0 0 var(--r)}table.t th:last-child{border-radius:0 var(--r) var(--r) 0}
table.t td{padding:13px 12px;font-size:14px;vertical-align:top}
table.t tbody tr:hover td{background:var(--s2)}
table.t th.n,table.t td.n{text-align:right}
table.t caption{text-align:left;color:var(--ink2);font-size:13px;padding:0 0 10px}
.state{border-radius:var(--r);background:var(--s2);padding:26px 22px;display:flex;flex-direction:column;align-items:flex-start;gap:8px}
.state h3{font-size:16px}
.state p{color:var(--ink2);max-width:62ch}
.state.error{background:var(--err-bg)}.state.warn{background:var(--warn-bg)}
.skel{background:var(--s2);border-radius:var(--r);min-height:18px}
.banner{display:flex;gap:10px;align-items:flex-start;padding:12px 14px;border-radius:var(--r);background:var(--warn-bg);color:var(--ink)}
.banner.info{background:var(--s2)}
.banner svg{margin-top:3px;width:16px;height:16px}
.tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin-bottom:18px;overflow-x:auto}
.tab{background:none;border:0;border-bottom:2px solid transparent;padding:12px 14px;min-height:44px;cursor:pointer;color:var(--ink2);font-weight:500;white-space:nowrap}
.tab[aria-selected=true],.tab[aria-current=page]{color:var(--accent);border-bottom-color:var(--accent)}
.seg{display:inline-flex;background:var(--s2);border-radius:var(--r);padding:3px;gap:2px;flex-wrap:wrap}
.seg button{border:0;background:none;min-height:40px;min-width:44px;padding:0 12px;border-radius:6px;cursor:pointer;font-family:var(--mono);font-size:13px;color:var(--ink2)}
.seg button[aria-pressed=true]{background:var(--accent);color:var(--on-accent);font-weight:600}
.field{display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink2);min-width:0}
.field select{min-height:44px;background:var(--s2);border:1px solid transparent;border-radius:var(--r);padding:0 12px;color:var(--ink);max-width:100%}
.field input[type=range]{width:100%;min-height:44px;accent-color:var(--accent)}
.sw{width:18px;height:18px;border-radius:4px;display:inline-block;flex:none;vertical-align:middle}
.sw.s3{background:var(--accent)}
.sw.s1{background-color:rgba(var(--hi),.28);background-image:repeating-linear-gradient(135deg,var(--ink) 0 1.5px,transparent 1.5px 5px)}
.sw.s2{background-color:rgba(var(--hi),.28);background-image:radial-gradient(circle,var(--ink) 1.2px,transparent 1.6px);background-size:5px 5px}
.sw.s0{border:1.5px dashed var(--muted);background:none}
.sw.pred{background:var(--s2);border:2px solid var(--accent)}
.legend{display:flex;gap:6px 18px;flex-wrap:wrap;font-size:13px;color:var(--ink2)}
.legend span{display:inline-flex;gap:8px;align-items:center}
.diverge{height:12px;border-radius:6px;background:linear-gradient(90deg,#5aa9e6,#1b222c 50%,#e8924a)}
.bar{display:flex;height:14px;border-radius:7px;overflow:hidden;gap:2px;background:var(--s2)}
.bar i{display:block;height:100%}

/* ---------- heatmap ---------- */
.heat{display:grid;gap:3px;min-width:420px}
.heat .hc,.heat .hh{min-height:40px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-variant-numeric:tabular-nums;font-size:14px;font-weight:500;border:0;padding:0;cursor:pointer;position:relative}
.heat.sm .hc,.heat.sm .hh{min-height:30px;font-size:12px}
.heat .hh{background:none;color:var(--ink2);font-size:13px;font-weight:500;cursor:default}
.heat .hc.miss{border:1.5px dashed var(--muted);color:var(--muted);background:none!important}
.heat .hc.sel{outline:3px solid var(--ink);outline-offset:1px;z-index:1}
.heat .hc[disabled]{cursor:default}
.axis-t{font-size:13px;color:var(--ink2);margin:8px 0 0}

/* ---------- workbench shell ---------- */
.wb{display:grid;grid-template-columns:240px minmax(0,1fr);min-height:100vh;background:var(--bg)}
.side{background:var(--s1);padding:24px 14px;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:20px;overflow-y:auto}
.brand{padding:0 8px;text-decoration:none;color:var(--ink);display:block}
.brand b{display:block;font-size:17px;letter-spacing:-.02em;line-height:1.25}
.brand span{font-size:13px;color:var(--ink2)}
.nav{display:flex;flex-direction:column;gap:2px;margin:0;padding:0;list-style:none}
.nav a,.homelink{display:flex;gap:12px;align-items:center;padding:0 12px;min-height:44px;border-radius:var(--r);color:var(--ink2);text-decoration:none;font-weight:500}
.nav a svg,.homelink svg{width:18px;height:18px}
.nav a:hover,.homelink:hover{background:var(--s2);color:var(--ink)}
.nav a[aria-current=page]{background:var(--s3);color:var(--accent)}
.homelink{margin-top:auto}
.main{min-width:0;padding:0 32px 64px}
.top{display:flex;justify-content:space-between;align-items:center;gap:16px 24px;padding:22px 0 8px;flex-wrap:wrap}
.top h1{font-size:32px}
.ctx{display:flex;gap:6px 20px;flex-wrap:wrap;color:var(--ink2);font-size:14px;align-items:center}
.ctx b{font-weight:500;color:var(--ink)}
.lede{color:var(--ink2);max-width:70ch;margin:4px 0 24px}
.mbar{display:none}
.drawerbg{display:none}
.grid2{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:24px}
.grid2.even{grid-template-columns:repeat(2,minmax(0,1fr))}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.qa{display:grid;grid-template-columns:minmax(150px,.9fr) 2.2fr auto;gap:8px 20px;padding:16px 0;align-items:start}
.qa .q{color:var(--ink2);font-size:14px}
.qa .rt{display:flex;flex-direction:column;gap:6px;align-items:flex-start}
.pipe{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px}
.node{background:var(--s2);border-radius:var(--r);padding:14px 16px;display:flex;flex-direction:column;gap:10px;min-height:96px}
.node .nh{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}
.node .nm{font-weight:600;line-height:1.3}
.node .ns{font-size:13px;color:var(--ink2)}
.node.blocked{box-shadow:inset 3px 0 0 var(--block)}
.sel-readout{min-height:2.6em}
.bars{display:flex;align-items:center;gap:8px;justify-content:flex-end}
.bars i{display:inline-block;height:8px;border-radius:4px;background:var(--accent);min-width:2px}
.bars i.neg{background:var(--plan)}
.chart svg{width:100%;height:auto;display:block;overflow:visible}
.chart text{fill:var(--ink2);font-size:12px;font-family:var(--font)}

/* ---------- landing ---------- */
.ln{background:var(--bg);color:var(--ink)}
.wrap{max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,48px)}
.lnav{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 0;flex-wrap:wrap}
.lnav .brand{padding:0}
.lnav ul{display:flex;gap:6px;list-style:none;margin:0;padding:0}
.lnav ul a{display:inline-flex;align-items:center;min-height:44px;padding:0 12px;color:var(--ink2);text-decoration:none;font-weight:500;border-radius:var(--r)}
.lnav ul a:hover{color:var(--ink)}
.lnav ul a[aria-current=page]{color:var(--accent)}
.lmenu{display:none}
.hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.02fr);gap:clamp(24px,5vw,72px);align-items:center;padding:clamp(40px,8vw,104px) 0 clamp(48px,8vw,96px)}
.hero h1{font-size:clamp(2.4rem,5vw,4.5rem);line-height:.98;letter-spacing:-.035em}
.hero .sub{font-size:clamp(1.05rem,1.6vw,1.3rem);color:var(--ink2);max-width:46ch;margin:28px 0 36px;line-height:1.55}
.hero .acts{display:flex;gap:20px;align-items:center;flex-wrap:wrap}
.plate{background:#0c1016;color:#e6ebf2;border-radius:16px;padding:clamp(18px,3vw,32px)}
.plate h2,.plate h3{font-size:15px;font-weight:500;color:#a7b2c2;letter-spacing:0}
.plate .cap{font-size:13px;color:#a7b2c2;margin-top:14px}
.cgrid{display:grid;grid-template-columns:auto repeat(9,minmax(0,1fr));gap:4px;align-items:center;margin-top:16px}
.cgrid .c{aspect-ratio:1.5;border-radius:4px;min-height:22px}
.cgrid .c.s3{background:#86c8e8}
.cgrid .c.s1{background-color:rgba(134,200,232,.22);background-image:repeating-linear-gradient(135deg,#86c8e8 0 1.5px,transparent 1.5px 5px)}
.cgrid .c.s2{background-color:rgba(134,200,232,.22);background-image:radial-gradient(circle,#86c8e8 1.2px,transparent 1.6px);background-size:5px 5px}
.cgrid .c.s0{border:1.5px dashed #7d8999}
.cgrid .rl{font-family:var(--mono);font-size:12px;color:#a7b2c2;padding-right:8px;text-align:right}
.meta{font-size:14px;color:var(--ink2);margin-top:14px}
.sec{padding:clamp(56px,9vw,120px) 0}
.sec.step{background:var(--s2)}
.sec h2.big{font-size:clamp(1.9rem,3.6vw,2.9rem);letter-spacing:-.03em;max-width:18ch}
.split{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(24px,5vw,72px)}
.split p+p{margin-top:18px}
.split .txt{font-size:1.125rem;line-height:1.6;color:var(--ink2);max-width:62ch}
.pull{margin-top:28px;padding-left:18px;border-left:3px solid var(--accent)}
.pull p{color:var(--ink);font-size:1.05rem;margin-top:10px}
.caprow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 24px;padding:18px 0;align-items:center}
.caprow h3{font-size:1.1rem;font-weight:500;letter-spacing:-.01em}
.caprow p{color:var(--ink2);font-size:.95rem;grid-column:1}
.caprow .chip{grid-column:2;grid-row:1/span 2;align-self:center}
.prev{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:20px;margin-top:20px}
.prev .side2{background:#121821;border-radius:12px;padding:18px;color:#e6ebf2;align-self:start}
.prev .side2 h3{font-size:15px;font-weight:600;color:#e6ebf2}
.prev .side2 dl{display:grid;grid-template-columns:1fr auto;gap:10px 12px;margin:14px 0 0}
.prev .side2 dt{color:#a7b2c2}.prev .side2 dd{margin:0;font-variant-numeric:tabular-nums}
.plate .seg{background:#18202b}.plate .seg button{color:#a7b2c2}.plate .seg button[aria-pressed=true]{background:#86c8e8;color:#0c1016}
.plate .chip{background:#18202b;color:#a7b2c2}
.tl{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:20px 12px;margin:44px 0 0;padding:0;list-style:none}
.tl li{display:flex;flex-direction:column;align-items:flex-start;gap:8px;position:relative;padding-top:6px}
.tl li::before{content:"";position:absolute;left:0;right:-12px;top:24px;height:2px;background:var(--line)}
.tl li:last-child::before{right:0}
.tl .dot{position:relative;z-index:1;width:36px;height:36px;border-radius:50%;background:var(--s2);display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 2px var(--line)}
.tl .dot svg{width:20px;height:20px}
.tl b{font-weight:600;line-height:1.3}
.tl small{font-size:13px;color:var(--ink2)}
.integ{background:var(--s2);border-radius:20px;padding:clamp(24px,4vw,56px)}
.integ .l2{display:flex;flex-direction:column;gap:16px;margin-top:16px}
.integ .l2 div{display:flex;gap:12px;align-items:center;color:var(--ink)}
.stl{display:flex;flex-direction:column;gap:14px;margin:0}
.stl>div{display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap}
.stl dt{color:var(--ink2)}.stl dd{margin:0}
.dl2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 48px;margin-top:28px;list-style:none;padding:0}
.dl2 li a{display:flex;justify-content:space-between;align-items:center;padding:18px 0;color:var(--ink);text-decoration:none;font-weight:500;min-height:44px}
.dl2 li a:hover{color:var(--accent)}
.lfoot{background:var(--s2);padding:32px 0;margin-top:clamp(40px,6vw,80px)}
.lfoot .wrap{display:flex;gap:16px 32px;justify-content:space-between;align-items:center;flex-wrap:wrap}
.lfoot nav{display:flex;gap:20px;flex-wrap:wrap}
.lfoot a{color:var(--ink2);text-decoration:none;min-height:44px;display:inline-flex;align-items:center}
.reveal{opacity:0;transform:translateY(16px);transition:opacity .5s ease-out,transform .5s ease-out}
.reveal.in{opacity:1;transform:none}
.noscript{padding:24px}

@media (max-width:1100px){.grid3{grid-template-columns:repeat(2,minmax(0,1fr))}.grid2{grid-template-columns:minmax(0,1fr)}.lnav>.btn.dark{display:none}}
@media (max-width:900px){
  .hero,.split,.prev{grid-template-columns:minmax(0,1fr)}
  .dl2{grid-template-columns:minmax(0,1fr)}
  .lmenu{display:inline-flex}
  .lnav ul{display:none;flex-direction:column;width:100%;order:3}
  .lnav ul.open{display:flex}
  .lnav .btn.dark{display:none}
  .wb{grid-template-columns:minmax(0,1fr)}
  .side{position:fixed;z-index:60;left:0;top:0;bottom:0;width:min(86vw,300px);transform:translateX(-102%);visibility:hidden;transition:transform .2s ease-out,visibility .2s;box-shadow:0 0 40px rgba(0,0,0,.5)}
  .side.open{transform:none;visibility:visible}
  .drawerbg.open{display:block;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:55}
  .mbar{display:flex;align-items:center;gap:12px;padding:12px 0;position:sticky;top:0;background:var(--bg);z-index:20}
  .main{padding:0 18px 56px}
  .top h1{font-size:26px}
  .qa{grid-template-columns:minmax(0,1fr)}
  .kv{grid-template-columns:minmax(0,1fr)}.kv dd{text-align:left}
  .grid3,.grid2.even{grid-template-columns:minmax(0,1fr)}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}.reveal{opacity:1;transform:none}}
@media (prefers-contrast:more){.panel,.state,.node{outline:1px solid var(--line)}}
@media (forced-colors:active){.heat .hc.sel{outline:3px solid Highlight}.chip{border:1px solid CanvasText}}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div id="app"></div>
<div id="live" class="sr" aria-live="polite" role="status"></div>
<noscript><p class="noscript">This research workbench needs JavaScript. All of its data is read from the local research API.</p></noscript>
<script>
"use strict";
/* =====================================================================================================
   Neural Volatility Surface · Quantitative Research Workbench
   Single self-contained file: the research server (backend/src/volatility_lab/api/server.py) serves exactly
   this one file under a strict CSP. No framework, no dependencies, no network calls except the GET routes of
   the same origin. Design reference: dashboard-design/. Every value is read from the API or is a labelled
   "Documented" snapshot of a project document; nothing here is a model result of its own.
   ===================================================================================================== */

/* ---------- small DOM helpers (API data never goes through innerHTML) ---------- */
const $ = (s, r = document) => r.querySelector(s);
function h(tag, attrs, ...kids) {
  const e = document.createElement(tag);
  if (attrs) for (const [k, v] of Object.entries(attrs)) {
    if (v == null || v === false) continue;
    if (k === "class") e.className = v;
    else if (k === "text") e.textContent = v;
    else if (k.startsWith("on")) e.addEventListener(k.slice(2), v);
    else e.setAttribute(k, v === true ? "" : v);
  }
  for (const c of kids.flat(Infinity)) { if (c == null || c === false) continue; e.append(c.nodeType ? c : document.createTextNode(String(c))); }
  return e;
}
